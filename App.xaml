<Application x:Class="PubQuizApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PubQuizApp.Converters"
             StartupUri="Views/QuizmasterWindow.xaml">
    <Application.Resources>
        <!-- Color Tokens -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#0B0F19" />
        <SolidColorBrush x:Key="BgCardBrush" Color="#151C2C" />
        <SolidColorBrush x:Key="BgCardHoverBrush" Color="#1E283E" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2A364F" />

        <SolidColorBrush x:Key="TextMainBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

        <SolidColorBrush x:Key="PurpleNeonBrush" Color="#8B5CF6" />
        <SolidColorBrush x:Key="CyanNeonBrush" Color="#06B6D4" />
        <SolidColorBrush x:Key="GreenNeonBrush" Color="#10B981" />
        <SolidColorBrush x:Key="RedNeonBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="AmberNeonBrush" Color="#F59E0B" />

        <!-- Converters for BooleanToVisibility -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Application.Resources>
</Application>
