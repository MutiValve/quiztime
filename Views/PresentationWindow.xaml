<Window x:Class="PubQuizApp.Views.PresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:PubQuizApp.Converters"
        mc:Ignorable="d"
        Title="PubQuiz - Presentation Screen (Audience Display)" 
        Height="768" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Top Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Progress Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="20,14" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#251842" CornerRadius="20" Padding="12,6" Margin="0,0,16,0" BorderBrush="{StaticResource PurpleNeonBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding CurrentQuiz.Category, FallbackValue='PUB QUIZ NIGHT', TargetNullValue='PUB QUIZ NIGHT'}" Foreground="{StaticResource PurpleNeonBrush}" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentQuiz.Title, FallbackValue='Ultimate Pub Trivia', TargetNullValue='Ultimate Pub Trivia'}" Foreground="{StaticResource TextMainBrush}" FontSize="22" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Points badge -->
                    <Border Background="#122E26" CornerRadius="12" Padding="14,6" Margin="0,0,16,0" BorderBrush="{StaticResource GreenNeonBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " FontSize="14"/>
                            <TextBlock Text="{Binding CurrentQuestion.Points, StringFormat='{}{0} PTS'}" Foreground="{StaticResource GreenNeonBrush}" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Question Count Badge -->
                    <Border Background="#142634" CornerRadius="12" Padding="16,6" BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding QuestionDisplayNumber, StringFormat='QUESTION {0}'}" Foreground="{StaticResource CyanNeonBrush}" FontWeight="ExtraBold" FontSize="15"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN QUIZ PRESENTATION AREA -->
        <Grid Grid.Row="1" Visibility="{Binding IsQuizEnded, Converter={StaticResource InverseBoolToVis}}">
            <!-- If Quiz is actively running -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COL: QUESTION & ANSWERS -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Question Text Card -->
                <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="20" Padding="28,24" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentQuestion.QuestionText, FallbackValue='Select a quiz on the Quizmaster control screen to begin!', TargetNullValue='Select a quiz on the Quizmaster control screen to begin!'}" 
                                       Foreground="{StaticResource TextMainBrush}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" LineHeight="38"/>
                        </StackPanel>

                        <!-- Optional Question Image -->
                        <Border Grid.Column="1" Width="140" Height="100" CornerRadius="12" Margin="20,0,0,0" ClipToBounds="True"
                                Visibility="{Binding CurrentQuestion.HasImage, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding CurrentQuestion.ImageUrl}" Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Multiple Choice Answer Cards Grid (4 Items) -->
                <Grid Grid.Row="1">
                    <!-- Shown when options are hidden -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Visibility="{Binding ShowOptions, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="LISTEN TO THE QUIZMASTER" Foreground="{StaticResource TextMainBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Answers will be revealed shortly..." Foreground="{StaticResource TextMutedBrush}" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Shown when options are active -->
                    <ItemsControl ItemsSource="{Binding CurrentQuestion.Answers}" Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Rows="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="8" CornerRadius="16" Padding="20" BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <!-- If Answer Reveal is ON and this option is correct -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding DataContext.RevealAnswer, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        <Condition Binding="{Binding IsCorrect}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#12382A"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource GreenNeonBrush}"/>
                                                </MultiDataTrigger>
                                                <!-- If Answer Reveal is ON and this option is wrong -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding DataContext.RevealAnswer, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        <Condition Binding="{Binding IsCorrect}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding AnswerText}" Foreground="{StaticResource TextMainBrush}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                        <!-- Correct Answer Icon Indicator -->
                                        <Border Grid.Column="1" Background="{StaticResource GreenNeonBrush}" CornerRadius="16" Width="32" Height="32" Margin="10,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding DataContext.RevealAnswer, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                <Condition Binding="{Binding IsCorrect}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Explanation / Host Fact Banner -->
                <Border Grid.Row="2" Background="#1E1938" CornerRadius="14" Padding="20,14" Margin="0,16,0,0" BorderBrush="{StaticResource PurpleNeonBrush}" BorderThickness="1"
                        Visibility="{Binding ShowExplanation, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡 " FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="FACT: " Foreground="{StaticResource PurpleNeonBrush}" FontWeight="ExtraBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CurrentQuestion.Explanation, FallbackValue='Enjoy the pub quiz!', TargetNullValue='Enjoy the pub quiz!'}" Foreground="{StaticResource TextMainBrush}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT COL: COUNTDOWN TIMER DISPLAY -->
            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" CornerRadius="20" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="COUNTDOWN" Foreground="{StaticResource TextMutedBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                    <!-- Big Circular Clock Gauge -->
                    <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Width="180" Height="180" Stroke="#232E44" StrokeThickness="12"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TimerSeconds}" FontSize="64" FontWeight="ExtraBold" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource CyanNeonBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTimerWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource RedNeonBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="SECONDS" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Status indicator -->
                    <Border Grid.Row="2" CornerRadius="12" Padding="12,8" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1A2438"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                        <Setter Property="Background" Value="#143029"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding IsTimerRunning, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource GreenNeonBrush}" FontWeight="Bold" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⏹ PAUSED"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                            <Setter Property="Text" Value="⏳ TIMER TICKING"/>
                                            <Setter Property="Foreground" Value="{StaticResource GreenNeonBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- CELEBRATION / QUIZ ENDED SCREEN -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="20" Padding="40" BorderBrush="{StaticResource PurpleNeonBrush}" BorderThickness="2"
                Visibility="{Binding IsQuizEnded, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="QUIZ COMPLETED!" Foreground="{StaticResource TextMainBrush}" FontSize="48" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="20" HorizontalAlignment="Center" Margin="0,10,0,30"><Run Text="Thank you for playing "/><Run Language="nl-nl" Text="my PubQuiz!"/><Run Text="!"/></TextBlock>

                <!-- Team Leaderboard Box -->
                <Border Background="#0E1422" CornerRadius="16" Padding="24" Width="500" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🏆 FINAL TEAM LEADERBOARD" Foreground="{StaticResource AmberNeonBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding Teams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16,12" Margin="0,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TeamName}" Foreground="{StaticResource TextMainBrush}" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Score, StringFormat='{}{0} PTS'}" Foreground="{StaticResource CyanNeonBrush}" FontSize="18" FontWeight="ExtraBold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <ProgressBar Grid.Row="2" Height="8" Value="{Binding ProgressRatio, Mode=OneWay}" Maximum="1.0" Foreground="{StaticResource CyanNeonBrush}" Background="#1A2438" BorderThickness="0" Margin="0,16,0,0"/>
    </Grid>
</Window>
