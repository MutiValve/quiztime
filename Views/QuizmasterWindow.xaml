<Window x:Class="PubQuizApp.Views.QuizmasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PubQuiz - Quizmaster Control Center" 
        Height="850" Width="1350"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Row 0: API Connection & Quiz Selector Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main Control Deck -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: API & QUIZ SELECTOR -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="14" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text=" " FontSize="22"/>
                    <TextBlock Text="Quizmaster Control" Foreground="{StaticResource TextMainBrush}" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- API Server URL Input -->
                <TextBox Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Background="#0E1422" Foreground="{StaticResource TextMainBrush}" 
                         BorderBrush="{StaticResource BorderBrush}" Padding="8,6" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="PHP Backend API Base URL"/>

                <!-- Fetch Button -->
                <Button Grid.Column="2" Command="{Binding ConnectApiCommand}" Content="Fetch" Background="#1A2744" Foreground="{StaticResource CyanNeonBrush}" 
                        BorderBrush="{StaticResource CyanNeonBrush}" Padding="12,6" FontWeight="Bold" Margin="0,0,20,0" Cursor="Hand" Click="Button_Click"/>

                <!-- Quiz Selector Dropdown -->
                <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableQuizzes}" SelectedItem="{Binding SelectedQuizSummary}" DisplayMemberPath="DisplayText"
                          Background="#0E1422" Foreground="Black" Padding="8,6" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <!-- Load Quiz Button -->
                <Button Grid.Column="4" Command="{Binding LoadQuizCommand}" Content="⚡ Load Selected Quiz" Background="{StaticResource PurpleNeonBrush}" Foreground="White" 
                        Padding="16,8" FontWeight="Bold" Margin="0,0,16,0" Cursor="Hand" Click="Button_Click_1"/>

                <!-- Launch Presentation Window Button -->
                <Button Grid.Column="5" Click="OpenPresentationWindow_Click" Content="🖥️ Open Presentation Screen" Background="#12382A" Foreground="{StaticResource GreenNeonBrush}" 
                        BorderBrush="{StaticResource GreenNeonBrush}" Padding="16,8" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- MAIN CONTROL DECK -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COL: TIMER & STAGE CONTROLS -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">

                <!-- TIMER CONTROL CARD -->
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TIMER CONTROL " Foreground="{StaticResource CyanNeonBrush}" FontWeight="ExtraBold" FontSize="14" Margin="0,0,0,14"/>

                        <!-- Digital Clock -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border Background="#0C1220" CornerRadius="16" Padding="30,12" BorderBrush="{StaticResource CyanNeonBrush}" BorderThickness="2">
                                <TextBlock Text="{Binding TimerSeconds, StringFormat='{}{0:D2}s'}" Foreground="{StaticResource CyanNeonBrush}" FontSize="48" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Main Play / Pause / Reset Buttons -->
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Button Command="{Binding StartTimerCommand}" Content="▶ START" Background="#12382A" Foreground="{StaticResource GreenNeonBrush}" Padding="10,12" FontWeight="Bold" Margin="3" Cursor="Hand"/>
                            <Button Command="{Binding PauseTimerCommand}" Content="⏸ PAUSE" Background="#3D2912" Foreground="{StaticResource AmberNeonBrush}" Padding="10,12" FontWeight="Bold" Margin="3" Cursor="Hand"/>
                            <Button Command="{Binding ResetTimerCommand}" Content="🔄 RESET" Background="#263147" Foreground="{StaticResource TextMainBrush}" Padding="10,12" FontWeight="Bold" Margin="3" Cursor="Hand"/>
                        </UniformGrid>

                        <!-- Presets & Nudge -->
                        <UniformGrid Columns="4">
                            <Button Command="{Binding SetTimerPresetCommand}" CommandParameter="10" Content="10s" Background="#162033" Foreground="{StaticResource TextMutedBrush}" Padding="4,6" Margin="2"/>
                            <Button Command="{Binding SetTimerPresetCommand}" CommandParameter="25" Content="25s" Background="#162033" Foreground="{StaticResource TextMutedBrush}" Padding="4,6" Margin="2"/>
                            <Button Command="{Binding SetTimerPresetCommand}" CommandParameter="30" Content="30s" Background="#162033" Foreground="{StaticResource TextMutedBrush}" Padding="4,6" Margin="2"/>
                            <Button Command="{Binding SetTimerPresetCommand}" CommandParameter="60" Content="60s" Background="#162033" Foreground="{StaticResource TextMutedBrush}" Padding="4,6" Margin="2"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- STAGE VISIBILITY CONTROLS -->
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource PurpleNeonBrush}" FontWeight="ExtraBold" FontSize="14" Margin="0,0,0,14"><Run Text="AUDIENCE DISPLA"/><Run Language="nl-nl" Text="Y"/><Run Text=" "/></TextBlock>

                        <!-- Toggle Show Options -->
                        <ToggleButton IsChecked="{Binding ShowOptions, Mode=TwoWay}" Padding="12,12" Margin="0,0,0,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👁️ " FontSize="16"/>
                                <TextBlock Text="Show Choices to Audience" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Toggle Reveal Answer -->
                        <ToggleButton IsChecked="{Binding RevealAnswer, Mode=TwoWay}" Padding="12,12" Margin="0,0,0,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨ " FontSize="16"/>
                                <TextBlock Text="REVEAL CORRECT ANSWER" FontWeight="Bold" Foreground="{StaticResource GreenNeonBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Toggle Explanation -->
                        <ToggleButton IsChecked="{Binding ShowExplanation, Mode=TwoWay}" Padding="12,12" Margin="0,0,0,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡 " FontSize="16"/>
                                <TextBlock Text="Show Explanation Fact" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- End Quiz Toggle -->
                        <ToggleButton IsChecked="{Binding IsQuizEnded, Mode=TwoWay}" Padding="12,12" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏆 " FontSize="16"/>
                                <TextBlock Text="SHOW FINAL LEADERBOARD" FontWeight="Bold" Foreground="{StaticResource AmberNeonBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- MIDDLE COL: QUESTION NAVIGATOR & QUIZMASTER NOTES -->
            <Grid Grid.Column="1" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- QUESTION NAVIGATION BAR -->
                <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="18,14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Command="{Binding PrevQuestionCommand}" Content="◀ PREV" Background="#1F2B42" Foreground="{StaticResource TextMainBrush}" Padding="16,10" FontWeight="Bold" Cursor="Hand"/>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding QuestionDisplayNumber, StringFormat='QUESTION {0}'}" Foreground="{StaticResource CyanNeonBrush}" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentQuiz.Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding NextQuestionCommand}" Content="NEXT ▶" Background="{StaticResource PurpleNeonBrush}" Foreground="White" Padding="20,10" FontWeight="Bold" Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- QUIZMASTER CHEAT SHEET CARD -->
                <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#172238" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock Text="🔒 QUIZMASTER PRIVATE NOTES" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Bold"/>
                            </Border>

                            <!-- Question Text -->
                            <TextBlock Text="{Binding CurrentQuestion.QuestionText, FallbackValue='No question loaded. Select a quiz above.', TargetNullValue='No question loaded. Select a quiz above.'}" 
                                       Foreground="{StaticResource TextMainBrush}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,20"/>

                            <!-- Correct Answer Highlighted Box -->
                            <Border Background="#12382A" CornerRadius="12" Padding="18,14" Margin="0,0,0,20" BorderBrush="{StaticResource GreenNeonBrush}" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="✅ CORRECT ANSWER:" Foreground="{StaticResource GreenNeonBrush}" FontSize="13" FontWeight="ExtraBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CorrectAnswerText}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- All Choice Options List -->
                            <TextBlock Text="ALL CHOICE OPTIONS:" Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding CurrentQuestion.Answers}" Margin="0,0,0,20">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,8" Margin="0,3" CornerRadius="8" Background="#0F1626">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding AnswerText}" Foreground="{StaticResource TextMainBrush}" FontSize="15"/>
                                                <TextBlock Grid.Column="1" Text="[CORRECT]" Foreground="{StaticResource GreenNeonBrush}" FontWeight="Bold" Visibility="{Binding IsCorrect, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Explanation / Background Lore -->
                            <TextBlock Text="HOST BACKGROUND LORE / FACT:" Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Border Background="#1A182E" CornerRadius="10" Padding="14" BorderBrush="{StaticResource PurpleNeonBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding CurrentQuestion.Explanation, FallbackValue='No additional notes for this question.', TargetNullValue='No additional notes for this question.'}" Foreground="{StaticResource TextMainBrush}" FontSize="14" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- RESTART SESSION BAR -->
                <Button Grid.Row="2" Command="{Binding RestartSessionCommand}" Content="Restart Quiz Session" Background="#261A1A" Foreground="{StaticResource RedNeonBrush}" BorderBrush="{StaticResource RedNeonBrush}" Padding="12,10" FontWeight="Bold" Margin="0,16,0,0" Cursor="Hand" Click="Button_Click_2"/>
            </Grid>

            <!-- RIGHT COL: TEAM SCOREBOARD DECK -->
            <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="TEAM SCOREBOARD" Foreground="{StaticResource AmberNeonBrush}" FontWeight="ExtraBold" FontSize="15"/>
                    </StackPanel>

                    <!-- Teams List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Teams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F1626" CornerRadius="12" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBox Text="{Binding TeamName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextMainBrush}" BorderThickness="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Score, StringFormat='{}{0} pts'}" Foreground="{StaticResource CyanNeonBrush}" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Center"/>

                                                <!-- Score adjust buttons -->
                                                <Button Grid.Column="1" Click="MinusPoints_Click" Content="-10" Background="#2B1A1D" Foreground="{StaticResource RedNeonBrush}" Padding="8,4" Margin="4,0" FontWeight="Bold" Cursor="Hand"/>
                                                <Button Grid.Column="2" Click="AddPoints_Click" Content="+10" Background="#16382B" Foreground="{StaticResource GreenNeonBrush}" Padding="8,4" FontWeight="Bold" Cursor="Hand"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Add Team Button -->
                    <Button Grid.Row="2" Command="{Binding AddTeamCommand}" Content="➕ Add Team" Background="#1F2B42" Foreground="{StaticResource TextMainBrush}" Padding="12,10" FontWeight="Bold" Margin="0,10,0,0" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#0C121F" CornerRadius="8" Padding="14,8" Margin="0,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="PubQuiz Central v1.0 • WPF .NET 10" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
